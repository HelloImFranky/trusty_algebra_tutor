{
  "name": "trusty-algebra-tutor",
  "private": true,
  "version": "0.2.0",
  "description": "Middle school Algebra 1 tutor modeled on the Algebra 891 classroom (scaffolded lessons, Regents review, adaptive practice, EN/ES). Turborepo: Next.js web + Expo native + tRPC + Prisma.",
  "repository": {
    "type": "git",
    "url": "https://github.com/HelloImFranky/trusty_algebra_tutor.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "./scripts/start.sh",
    "dev": "turbo dev --filter=@tutor/web",
    "dev:native": "turbo dev --filter=@tutor/native",
    "build": "turbo build",
    "test": "turbo test && ./scripts/theme-baseline.sh && ./scripts/doc-banner-check.sh",
    "theme:baseline": "./scripts/theme-baseline.sh",
    "doc:banners": "./scripts/doc-banner-check.sh",
    "typecheck": "turbo typecheck",
    "seed": "npm run seed --workspace @tutor/db",
    "migrate": "npm run migrate --workspace @tutor/db",
    "create-admin": "npm run create-admin --workspace @tutor/api",
    "deploy": "node scripts/deploy-vercel.mjs",
    "release": "commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run",
    "release:first": "commit-and-tag-version --first-release"
  },
  "devDependencies": {
    "commit-and-tag-version": "^13.1.0",
    "turbo": "^2.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.7",
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "~19.1.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native": "0.81.5"
  }
}
