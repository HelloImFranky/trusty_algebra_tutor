// Prisma models for the Algebra Tutor. The SQL source of truth stays in
// ../migrations (idempotent, applied by src/migrate.ts on boot) so existing
// databases — however old — upgrade in place; this schema
// mirrors those tables for type-safe queries. IDs are BIGINT in Postgres, so
// they surface as BigInt here; the API layer converts to number at its DTO
// boundary.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x is what Vercel's serverless
  // runtime (Amazon Linux) needs — pinned so a failed libssl detection can
  // never generate the wrong engine.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               BigInt    @id @default(autoincrement())
  role             String
  username         String    @unique
  passwordHash     String    @map("password_hash")
  displayName      String    @map("display_name")
  locale           String    @default("en")
  grade            Int?
  email            String?
  guardianConsent  Boolean   @default(false) @map("guardian_consent")
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  refreshTokens    RefreshToken[]
  attempts         Attempt[]
  mastery          Mastery[]
  tutorSessions    TutorSession[]
  calculatorSession CalculatorSession?
  regentsAnswers   RegentsAnswer[]
  guardianOf       GuardianLink[] @relation("guardian")
  guardians        GuardianLink[] @relation("student")
  classesTaught    Class[]           @relation("teacher")
  enrollments      ClassEnrollment[] @relation("student")
  guardianConsents GuardianConsent[] @relation("consentStudent")

  @@map("users")
}

model Class {
  id            BigInt            @id @default(autoincrement())
  teacherUserId BigInt            @map("teacher_user_id")
  name          String
  joinCode      String            @unique @map("join_code")
  archived      Boolean           @default(false)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  teacher       User              @relation("teacher", fields: [teacherUserId], references: [id], onDelete: Cascade)
  enrollments   ClassEnrollment[]

  @@index([teacherUserId], map: "idx_classes_teacher")
  @@map("classes")
}

model ClassEnrollment {
  classId       BigInt   @map("class_id")
  studentUserId BigInt   @map("student_user_id")
  status        String   @default("active")
  joinedAt      DateTime @default(now()) @map("joined_at") @db.Timestamptz()
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student       User     @relation("student", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@id([classId, studentUserId])
  @@index([studentUserId], map: "idx_enrollments_student")
  @@map("class_enrollments")
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}

model GuardianLink {
  guardianUserId BigInt @map("guardian_user_id")
  studentUserId  BigInt @map("student_user_id")
  status         String @default("active")
  guardian       User   @relation("guardian", fields: [guardianUserId], references: [id], onDelete: Cascade)
  student        User   @relation("student", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@id([guardianUserId, studentUserId])
  @@map("guardian_links")
}

model GuardianConsent {
  id              BigInt    @id @default(autoincrement())
  studentUserId   BigInt    @map("student_user_id")
  method          String
  grantedByUserId BigInt?   @map("granted_by_user_id")
  guardianEmail   String?   @map("guardian_email")
  note            String?
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  revokedAt       DateTime? @map("revoked_at")
  student         User      @relation("consentStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId], map: "idx_guardian_consents_student")
  @@map("guardian_consents")
}

model Unit {
  id       BigInt   @id @default(autoincrement())
  number   Int      @unique
  titleEn  String   @map("title_en")
  titleEs  String   @map("title_es")
  position Int
  lessons  Lesson[]

  @@map("units")
}

model Lesson {
  id             BigInt           @id @default(autoincrement())
  unitId         BigInt           @map("unit_id")
  code           String           @unique
  titleEn        String           @map("title_en")
  titleEs        String           @map("title_es")
  position       Int
  contentVersion Int              @default(1) @map("content_version")
  mnemonicEn     String?          @map("mnemonic_en")
  mnemonicEs     String?          @map("mnemonic_es")
  unit           Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  steps          LessonStep[]
  scaffolds      LessonScaffold[]
  skills         Skill[]

  @@index([unitId], map: "idx_lessons_unit")
  @@map("lessons")
}

model LessonStep {
  id                 BigInt  @id @default(autoincrement())
  lessonId           BigInt  @map("lesson_id")
  position           Int
  bodyEn             String  @map("body_en")
  bodyEs             String  @map("body_es")
  workedExampleLatex String? @map("worked_example_latex")
  hintEn             String? @map("hint_en")
  hintEs             String? @map("hint_es")
  lesson             Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId], map: "idx_lesson_steps_lesson")
  @@map("lesson_steps")
}

model LessonScaffold {
  id       BigInt   @id @default(autoincrement())
  lessonId BigInt   @map("lesson_id")
  position Int
  title    String
  bodyMd   String   @map("body_md")
  images   String[] @default([])
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, position], map: "idx_lesson_scaffolds_lesson")
  @@map("lesson_scaffolds")
}

model Skill {
  id          BigInt    @id @default(autoincrement())
  lessonId    BigInt    @map("lesson_id")
  slug        String    @unique
  nameEn      String    @map("name_en")
  nameEs      String    @map("name_es")
  description String?
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  problems    Problem[]
  mastery     Mastery[]

  @@index([lessonId], map: "idx_skills_lesson")
  @@map("skills")
}

model Problem {
  id          BigInt        @id @default(autoincrement())
  skillId     BigInt        @map("skill_id")
  tier        String
  promptEn    String        @map("prompt_en")
  promptEs    String        @map("prompt_es")
  answerLatex String        @map("answer_latex")
  gradingMode String        @map("grading_mode")
  tolerance   Float?
  paramsJson  Json?         @map("params_json")
  misconceptionsJson Json?  @map("misconceptions_json")
  isSprint    Boolean       @default(false) @map("is_sprint")
  skill       Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  steps       ProblemStep[]
  attempts    Attempt[]
  tutorSessions TutorSession[]

  @@index([skillId, tier], map: "idx_problems_skill")
  @@map("problems")
}

model ProblemStep {
  id            BigInt  @id @default(autoincrement())
  problemId     BigInt  @map("problem_id")
  position      Int
  promptEn      String  @map("prompt_en")
  promptEs      String  @map("prompt_es")
  expectedLatex String  @map("expected_latex")
  gradingMode   String  @map("grading_mode")
  hintEn        String? @map("hint_en")
  hintEs        String? @map("hint_es")
  problem       Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId], map: "idx_problem_steps_problem")
  @@map("problem_steps")
}

model Attempt {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  problemId      BigInt   @map("problem_id")
  submittedLatex String   @map("submitted_latex")
  correct        Boolean
  misconceptionId String? @map("misconception_id")
  hintsUsed      Int      @default(0) @map("hints_used")
  animViews      Int      @default(0) @map("anim_views")
  stepReached    Int      @default(0) @map("step_reached")
  durationMs     Int?     @map("duration_ms")
  context        String   @default("practice")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "idx_attempts_user")
  @@index([userId, problemId], map: "idx_attempts_user_problem")
  @@map("attempts")
}

model Mastery {
  userId          BigInt    @map("user_id")
  skillId         BigInt    @map("skill_id")
  score           Float     @default(0)
  attemptsCount   Int       @default(0) @map("attempts_count")
  lastPracticedAt DateTime? @map("last_practiced_at") @db.Timestamptz()
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill           Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@map("mastery")
}

model TutorSession {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  problemId      BigInt?  @map("problem_id")
  lessonId       BigInt?  @map("lesson_id")
  transcriptJson Json     @default("[]") @map("transcript_json")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem        Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  @@index([userId], map: "idx_tutor_sessions_user")
  @@map("tutor_sessions")
}

model RegentsAnswer {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  topicSlug   String   @map("topic_slug")
  questionId  String   @map("question_id")
  choiceIndex Int      @map("choice_index")
  correct     Boolean
  /// 0 = handwritten bank; >= 1 = generated "practice again" sets
  round       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId], map: "regents_answers_user_question_key")
  @@index([userId, topicSlug], map: "idx_regents_answers_user_topic")
  @@map("regents_answers")
}

model CalculatorSession {
  userId    BigInt   @id @map("user_id")
  state     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calculator_sessions")
}
