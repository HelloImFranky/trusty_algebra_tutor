{
  "name": "@tutor/db",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/embed-migrations.mjs && prisma generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "node scripts/embed-migrations.mjs && prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@tutor/core": "*",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "prisma": "^6.5.0",
    "tsx": "^4.15.0",
    "typescript": "^5.7.0"
  }
}
