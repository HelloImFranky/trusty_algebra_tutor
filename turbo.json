{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL", "JWT_SECRET", "NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL_UNPOOLED", "NEON_PROJECT_ID",
    "PGDATABASE", "PGHOST", "PGHOST_UNPOOLED", "PGPASSWORD", "PGUSER",
    "POSTGRES_DATABASE", "POSTGRES_HOST", "POSTGRES_PASSWORD",
    "POSTGRES_PRISMA_URL", "POSTGRES_URL", "POSTGRES_URL_NON_POOLING",
    "POSTGRES_URL_NO_SSL", "POSTGRES_USER"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "TUTOR_PROVIDER", "TUTOR_BASE_URL", "TUTOR_MODEL", "TUTOR_API_KEY",
        "HF_TOKEN", "ANTHROPIC_API_KEY", "ANTHROPIC_MODEL", "NEXT_PUBLIC_*"
      ],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "generated/**"]
    },
    "generate": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
